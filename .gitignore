# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which might contain sensitive data
*.tfvars
*.tfvars.json

# Override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Backend override (created dynamically by CI/CD)
backend-override.tf

# Include tfvars examples
!terraform-workspace-only.tfvars.example

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore service account keys
*.json
!.github/**/*.json
!package.json
!package-lock.json
!tsconfig.json

# Ignore lock file (optional - some teams commit this)
# .terraform.lock.hcl

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
.classpath

# Reference/example directories (remove if you want to keep them)
reexternalredatabricksdeploymentvizio/

# Terraform plan files
*.tfplan
plan-output.txt
apply-output.txt

